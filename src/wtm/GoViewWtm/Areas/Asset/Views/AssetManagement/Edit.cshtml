@model GoViewWtm.ViewModel.Asset.AssetManagementVMs.AssetManagementVM
@inject IStringLocalizer<Program> Localizer;

<wt:form vm="@Model">
<wt:row items-per-row="ItemsPerRowEnum.Two">
<wt:combobox field="Entity.AssetTypeId" items="AllAssetTypes"/>
<wt:textbox field="Entity.Title" />
<wt:textbox field="Entity.Remark" />
<wt:upload field="Entity.PhotoId" />
</wt:row>
    <wt:hidden field="Entity.ID" />
    <wt:row align="AlignEnum.Right">
        <wt:submitbutton />
        <wt:closebutton />
    </wt:row>
</wt:form>
